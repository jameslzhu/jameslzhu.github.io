---
import Base from '../layouts/Base.astro';

// ---------------------------------------------------------------
// Page copy. Edit this block; the markup below rarely needs touching.
// Paragraphs accept inline HTML, so links sit inline with the prose.
// ---------------------------------------------------------------

const name = 'James Zhu';

const socials = [
  { label: '@github', href: 'https://github.com/jameslzhu' },
  { label: '@keybase', href: 'https://keybase.io/jzhu' },
  { label: '@linkedin', href: 'https://www.linkedin.com/in/jameslzhu' },
];

const intro = [
  `Hello! I'm a senior undergraduate at UC Berkeley, studying computer science.`,
  `I am an alumni of <a class="underline" href="https://www.firstinspires.org/robotics/frc">FIRST Robotics</a>, <a class="underline" href="https://team3061.org">Team 3061</a>.`,
];

const teaching = [{ label: 'CS 168 Feedback', href: '/feedback' }];

const underConstruction = [
  { label: 'Photography', href: '/photos' },
  { label: 'Writing', href: '/blog' },
  { label: 'Projects', href: '/projects' },
];
---
<Base title={name}>
  <section class="section-rule mt-8 flex items-center gap-6 pb-4">
    <img class="h-32 sm:h-40" src="/planet-light.svg" alt="planet" />
    <div>
      <h1 class="font-serif text-4xl sm:text-5xl">{name}</h1>
      <ul class="mt-2 flex gap-4 font-mono font-bold">
        {socials.map((link) => (
          <li><a class="nav-link" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <div class="section-rule py-4 text-lg">
    {intro.map((para, i) => <p class={i === 0 ? '' : 'mt-4'} set:html={para} />)}
  </div>

  <section class="section-rule py-4">
    <h2 class="font-serif text-2xl font-bold">Teaching</h2>
    {teaching.map((link) => (
      <p class="mt-2"><a class="text-lg underline" href={link.href}>{link.label}</a></p>
    ))}
  </section>

  <section class="py-4">
    <h2 class="font-serif text-xl font-bold">Under construction:</h2>
    <ul class="mt-2 space-y-2 text-lg">
      {underConstruction.map((link) => (
        <li><a class="nav-link" href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </section>
</Base>
